<Window x:Class="OmniFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniFlow" Height="750" Width="1200"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="#0D1117" CornerRadius="16" BorderBrush="#30363D" BorderThickness="1" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.8" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="#010409" CornerRadius="16,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="20,30,0,20">
                        <Border Width="28" Height="28" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M13 10V3L4 14h7v7l9-11h-7z" Fill="White" Stretch="Uniform" Width="12" Height="12" Margin="0,2,0,0"/>
                        </Border>
                        <TextBlock Text="OmniFlow" Foreground="#E6EDF3" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="1" Style="{StaticResource IconButton}" Command="{Binding AddFileCommand}" Content="+ ADD FILES" HorizontalAlignment="Stretch" Margin="15,0,15,15" Padding="15,10" Foreground="#7C3AED" FontSize="12" FontWeight="Medium" Background="#161B22"/>

                    <ListBox Grid.Row="2" x:Name="FilesList" ItemsSource="{Binding ActiveFiles}" Background="Transparent" BorderThickness="0" Margin="10,0" PreviewMouseLeftButtonDown="FilesList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#8B949E" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="12" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DA3633"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    
                    <StackPanel Grid.Row="3" Margin="15,0,15,20">
                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding StartCommand}" Content="START STREAM" HorizontalAlignment="Stretch" Margin="0,0,0,10" Padding="0,10" FontSize="13"/>
                        <Button Style="{StaticResource IconButton}" Command="{Binding StopCommand}" Content="STOP STREAM" HorizontalAlignment="Stretch" Padding="0,8" FontSize="12" FontWeight="Medium" Foreground="#F85149" Background="#21262D"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="25,20,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Canvas>
                    <Ellipse Canvas.Left="400" Canvas.Top="-50" Width="350" Height="350" Fill="#7C3AED" Opacity="0.06">
                        <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#161B22" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="v1.5" Foreground="#8B949E" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Width="36" Height="32" HorizontalAlignment="Right" Click="CloseBtn_Click">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#8B949E" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#7F161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL EVENTS" Foreground="#8B949E" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalLogs}" Foreground="#E6EDF3" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#7F161B22" CornerRadius="10" BorderBrush="#99DA3633" BorderThickness="1" Padding="20,12" Margin="10,0">
                        <StackPanel>
                            <TextBlock Text="ERRORS" Foreground="#F85149" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ErrorCount}" Foreground="#F85149" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#7F161B22" CornerRadius="10" BorderBrush="#99D29922" BorderThickness="1" Padding="20,12" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="WARNINGS" Foreground="#D29922" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="{Binding WarnCount}" Foreground="#D29922" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filter Tabs & Search & Export -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding FilterCommand}" CommandParameter="ALL" Content="ALL" Foreground="#E6EDF3" FontSize="11" FontWeight="Medium" Background="#21262D" Style="{StaticResource IconButton}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Command="{Binding FilterCommand}" CommandParameter="ERROR" Content="ERRORS" Foreground="#F85149" FontSize="11" FontWeight="Medium" Background="#21262D" Style="{StaticResource IconButton}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Grid.Column="2" Command="{Binding FilterCommand}" CommandParameter="WARN" Content="WARNINGS" Foreground="#D29922" FontSize="11" FontWeight="Medium" Background="#21262D" Style="{StaticResource IconButton}" Padding="15,5"/>

                    <Border Grid.Column="3" CornerRadius="6" BorderThickness="1" Padding="10,0" HorizontalAlignment="Right" Width="300" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0D1117"/>
                                <Setter Property="BorderBrush" Value="#30363D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegexValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="#F85149"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="#8B949E" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Background="Transparent" BorderThickness="0" Foreground="#E6EDF3" FontSize="13" VerticalContentAlignment="Center" Margin="25,0,0,0" CaretBrush="#7C3AED"/>
                            <TextBlock Text="Regex search..." Foreground="#484F58" VerticalAlignment="Center" Margin="25,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Command="{Binding ExportCommand}" Content="EXPORT" Padding="15,8" Foreground="#3FB950" FontSize="11" FontWeight="Medium" Background="#21262D"/>
                </Grid>

                <!-- Log Viewer -->
                <Border Grid.Row="3" Background="#010409" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1">
                    <Grid>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#161B22" CornerRadius="12,12,0,0" Padding="20,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Live Stream" Foreground="#8B949E" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            
                            <ListBox x:Name="LogList" ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.ScrollChanged="LogList_ScrollChanged">
                                
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="250"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Foreground="#8B949E" FontFamily="Consolas" FontSize="12" VerticalAlignment="Top"/>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#7C3AED"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#F85149"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="#F85149"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="#D29922"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="#D29922"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Column="2" Text="{Binding SourceFile}" Foreground="#EC4899" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Properties}" Foreground="#8B949E" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="20,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#161B22"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>

                        <!-- Pause Indicator -->
                        <Border Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" 
                                Background="#AA161B22" CornerRadius="0,0,12,12" Padding="15,8" 
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" Fill="#D29922" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="PAUSED" Foreground="#D29922" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>