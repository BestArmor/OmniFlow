<Window x:Class="OmniFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniFlow" Height="700" Width="1200"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Border Background="#0D1117" CornerRadius="16" BorderBrush="#30363D" BorderThickness="1" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.8" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <!-- Фоновые свечения -->
            <Canvas>
                <Ellipse Canvas.Left="-100" Canvas.Top="-100" Width="400" Height="400" Fill="#7C3AED" Opacity="0.06">
                    <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="800" Canvas.Top="400" Width="350" Height="350" Fill="#EC4899" Opacity="0.06">
                    <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <Grid Margin="25,20,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M13 10V3L4 14h7v7l9-11h-7z" Fill="White" Stretch="Uniform" Width="12" Height="12" Margin="0,2,0,0"/>
                        </Border>
                        <TextBlock Text="OmniFlow" Foreground="#E6EDF3" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#161B22" CornerRadius="5" Padding="8,3" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" Foreground="#8B949E" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Width="36" Height="32" HorizontalAlignment="Right" Click="CloseBtn_Click">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#8B949E" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                </Grid>

                <!-- Metrics Dashboard -->
                <Grid Grid.Row="1" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#7F161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="20,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL EVENTS" Foreground="#8B949E" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="{Binding TotalLogs}" Foreground="#E6EDF3" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#7F161B22" CornerRadius="10" BorderBrush="#99DA3633" BorderThickness="1" Padding="20,12" Margin="10,0">
                        <StackPanel>
                            <TextBlock Text="ERRORS" Foreground="#F85149" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="{Binding ErrorCount}" Foreground="#F85149" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#7F161B22" CornerRadius="10" BorderBrush="#99D29922" BorderThickness="1" Padding="20,12" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="WARNINGS" Foreground="#D29922" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="{Binding WarnCount}" Foreground="#D29922" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Control Panel -->
                <Border Grid.Row="2" Background="#7F161B22" CornerRadius="10" BorderBrush="#30363D" BorderThickness="1" Padding="15,10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0D1117" CornerRadius="6" BorderBrush="#30363D" BorderThickness="1" Padding="10,0">
                            <Grid>
                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#8B949E" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBox x:Name="PathInput" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" Foreground="#E6EDF3" 
                                         FontSize="13" VerticalContentAlignment="Center" Margin="20,0,0,0" IsReadOnly="True" CaretBrush="#7C3AED"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding BrowseCommand}" Content="BROWSE" Margin="10,0,0,0" Padding="15,8" Foreground="#E6EDF3" FontSize="12" FontWeight="Medium" Background="#21262D"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Command="{Binding StartCommand}" Content="START TAIL" Margin="10,0,0,0" Padding="20,8" FontSize="12"/>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding StopCommand}" Content="STOP" Margin="10,0,0,0" Padding="15,8" FontSize="12" FontWeight="Medium" Foreground="#F85149" Background="#21262D"/>
                    </Grid>
                </Border>

                <!-- Filter Tabs -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Command="{Binding FilterCommand}" CommandParameter="ALL" Content="ALL" Foreground="#E6EDF3" FontSize="11" FontWeight="Medium" Background="#21262D" Style="{StaticResource IconButton}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Command="{Binding FilterCommand}" CommandParameter="ERROR" Content="ERRORS" Foreground="#F85149" FontSize="11" FontWeight="Medium" Background="#21262D" Style="{StaticResource IconButton}" Padding="15,5" Margin="0,0,5,0"/>
                    <Button Command="{Binding FilterCommand}" CommandParameter="WARN" Content="WARNINGS" Foreground="#D29922" FontSize="11" FontWeight="Medium" Background="#21262D" Style="{StaticResource IconButton}" Padding="15,5"/>
                </StackPanel>

                <!-- Log Viewer -->
                <Border Grid.Row="4" Background="#010409" CornerRadius="12" BorderBrush="#30363D" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#161B22" CornerRadius="12,12,0,0" Padding="20,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#3FB950" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="12" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Live Stream" Foreground="#8B949E" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <ListBox ItemsSource="{Binding FilteredLogs}" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" Foreground="#8B949E" FontFamily="Consolas" FontSize="12"/>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7C3AED"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#F85149"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="#D29922"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#E6EDF3" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="20,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#161B22"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>